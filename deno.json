{
  "name": "@fortemate/dicechess-bots-deno",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts src/*.ts && deno fmt --check && deno lint",
    "test": "deno test --allow-net --allow-env"
  },
  "imports": {
    "@fortemate/dicechess-engine": "npm:@fortemate/dicechess-engine@^0.12.0",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "fmt": { "lineWidth": 110, "singleQuote": true },
  "lock": true
}
